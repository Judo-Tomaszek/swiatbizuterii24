# Wzór pliku .env — skopiuj jako .env i uzupełnij. .env jest w .gitignore, .env.example trafia do repo.

# --- Shoper (sklep źródłowy, API tylko do ODCZYTU) ---
# Adres sklepu bez końcowego ukośnika
SHOPER_SHOP_URL=https://swiatbizuterii24.pl
# Identyfikator klienta (client_id) z panelu Shopera
SHOPER_CLIENT_ID=
# Token dostępu (access token) — wysyłany jako nagłówek "Authorization: Bearer <token>"
SHOPER_ACCESS_TOKEN=
# Opcjonalne — jeśli panel je pokazał (odnowienie tokenu po wygaśnięciu)
SHOPER_CLIENT_SECRET=
SHOPER_REFRESH_TOKEN=

# --- WooCommerce (sklep docelowy) — uzupełnimy na etapie importu ---
WC_URL=
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=

# --- Lokalny WordPress (docker-compose.yml) ---
WP_DB_PASSWORD=
WP_DB_ROOT_PASSWORD=
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=

# --- Poczta sklepu (SMTP skrzynki info@) — wysyłka e-maili WooCommerce i formularza ---
SB24_SMTP_HOST=
SB24_SMTP_PORT=587
SB24_SMTP_USER=
SB24_SMTP_PASSWORD=
# Tylko lokalnie: poczta do Mailpita zamiast SMTP (np. host.docker.internal:1025). Na serwerze puste.
SB24_MAILPIT=
# Ukryty adres logowania do panelu (WPS Hide Login) — nie publikować
WP_ADMIN_URL=
